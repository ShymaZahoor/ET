# Copy this to .env and adjust as needed.

# --- App ---
APP_NAME="EcoTwin API"
ENV=development

# --- Database (PostgreSQL + PostGIS) ---
# This matches the credentials in docker-compose.yml out of the box.
DATABASE_URL=postgresql+psycopg://ecotwin:ecotwin@localhost:5432/ecotwin

# --- CORS ---
# Comma-separated list is NOT supported by default pydantic-settings list
# parsing from env vars in this simple setup -- edit app/core/config.py's
# CORS_ORIGINS default directly, or switch it to read a JSON array string.

# --- Digital Twin Simulation ---
SIMULATION_ENABLED=true
SIMULATION_TICK_SECONDS=2.0
SIMULATION_SPEED_MULTIPLIER=1.0

# --- Threat Engine ---
CONFLICT_DISTANCE_METERS=150.0
